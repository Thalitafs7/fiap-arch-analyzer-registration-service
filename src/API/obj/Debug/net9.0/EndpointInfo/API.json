{
  "openapi": "3.0.1",
  "info": {
    "title": "Hacka IADT SOAT - Serviço API",
    "description": "Microserviço de Analise Diagreamas - IADT-SOAT",
    "version": "v1"
  },
  "paths": {
    "/api/analise": {
      "post": {
        "tags": [
          "Analise"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "Nome": {
                    "type": "string"
                  },
                  "Tipo": {
                    "type": "string"
                  },
                  "Descricao": {
                    "type": "string"
                  },
                  "Files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  },
                  "FileType": {
                    "$ref": "#/components/schemas/FileTypeEnum"
                  }
                }
              },
              "encoding": {
                "Nome": {
                  "style": "form"
                },
                "Tipo": {
                  "style": "form"
                },
                "Descricao": {
                  "style": "form"
                },
                "Files": {
                  "style": "form"
                },
                "FileType": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/webhooks/mercadopago": {
      "post": {
        "tags": [
          "WebhookIA"
        ],
        "parameters": [
          {
            "name": "data.id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-signature",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-request-id",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MercadoPagoWebhookPayload"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/MercadoPagoWebhookPayload"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/MercadoPagoWebhookPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FileTypeEnum": {
        "enum": [
          1,
          2,
          3,
          4
        ],
        "type": "integer",
        "format": "int32"
      },
      "MercadoPagoWebhookData": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MercadoPagoWebhookPayload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "liveMode": {
            "type": "boolean"
          },
          "type": {
            "type": "string",
            "nullable": true
          },
          "dateCreated": {
            "type": "string",
            "format": "date-time"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "apiVersion": {
            "type": "string",
            "nullable": true
          },
          "action": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "$ref": "#/components/schemas/MercadoPagoWebhookData"
          },
          "externalReference": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}