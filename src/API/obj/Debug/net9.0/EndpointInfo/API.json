      "post": {
        "tags": [
          "Analise"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "Nome": {
                    "type": "string"
                  },
                  "Tipo": {
                    "type": "string"
                  },
                  "Descricao": {
                    "type": "string"
                  },
                  "Files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  },
                  "FileType": {
                    "$ref": "#/components/schemas/FileTypeEnum"
                  }
                }
              },
              "encoding": {
                "Nome": {
                  "style": "form"
                },
                "Tipo": {
                  "style": "form"
                },
                "Descricao": {
                  "style": "form"
                },
                "Files": {
                  "style": "form"
                },
                "FileType": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/jobs/relatorio/{hash}": {
      "get": {
        "tags": [
          "Relatorio"
        ],
        "parameters": [
          {
            "name": "hash",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/webhooks/relatorios": {
      "post": {
        "tags": [
          "WebhookIA"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "AnaliseId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "DiagramaId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "Nome": {
                    "type": "string"
                  },
                  "URLS3Relatorio": {
                    "type": "string"
                  }
                }
              },
              "encoding": {
                "AnaliseId": {
                  "style": "form"
                },
                "DiagramaId": {
                  "style": "form"
                },
                "Nome": {
                  "style": "form"
                },
                "URLS3Relatorio": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/webhooks/analise/{hash}": {
      "get": {
        "tags": [
          "WebhookIA"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "hash",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FileTypeEnum": {
        "enum": [
          1,
          2,
          3,
          4
        ],
        "type": "integer",
        "format": "int32"
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
